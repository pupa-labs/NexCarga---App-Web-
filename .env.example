# GEMINI_API_KEY: Chave da API Gemini para o assistente inteligente NexIA e NexIA Verify (processamento exclusivamente no backend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base da aplicação NexCarga.
APP_URL="http://localhost:3000"

# SUPABASE (Banco de Dados Principal PostgreSQL & Autenticação)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# GOOGLE CLOUD STORAGE (Armazenamento privado de documentos NexCarga Docs & NexIA Verify)
GCS_PROJECT_ID=""
GCS_BUCKET_NAME="nexcarga-docs-private"
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""

# GOOGLE MAPS PLATFORM (NEXGRID Radar Georreferenciado e Cálculo de Rotas)
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""
